# ============================================================================
# ENVIRONMENT VARIABLES FOR TECH CAREER ASSESSMENT API
# ============================================================================
# Copy this file to .env and fill in real values before running the backend.
# For Render production deployment, set these variables in Render dashboard.
#
# IMPORTANT: Never commit .env file to Git! Use .env.example as template.
# ============================================================================

# --- GENERAL CONFIGURATION ---
ENVIRONMENT=development
# Options: development, production, staging
# Set to "production" when deploying to Render

FRONTEND_URL=http://localhost:5173
# Local development: http://localhost:5173
# Production (Render): https://career-assessment-frontend.onrender.com
# Used for CORS configuration

SECRET_KEY=your-random-secret-key-here
# Random secret used to sign auth tokens — MUST be unique and secure!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Keep this PRIVATE and never commit to Git
# For production: generate a strong random value and set in Render dashboard

# --- ADMIN CONFIGURATION ---
ADMIN_EMAILS=olalekanquadri58@gmail.com
# Comma-separated list of emails auto-granted admin access
# Example: admin@example.com,manager@example.com
# Users with these emails get is_admin=true on signup/login

# --- DATABASE CONFIGURATION ---
# ============================================================================
# LOCAL DEVELOPMENT (SQLite):
DATABASE_URL=sqlite:///./assessment.db

# PRODUCTION (PostgreSQL on Render):
# Copy the "Internal Database URL" from your Render Postgres service dashboard
# Format: postgresql://username:password@host:5432/dbname
# Example: postgresql://user_abc123:pass_xyz789@dpg-abc123.renders.com/dbname_xyz
# ============================================================================
# Note: psycopg2-binary is already in requirements.txt for PostgreSQL support

# --- EMAIL CONFIGURATION (Brevo Transactional Email API) ---
# ============================================================================
# Using Brevo (formerly Sendinblue) for transactional emails
# Render blocks SMTP ports (25/465/587), so we use HTTPS API instead
# Get your API key from: https://app.brevo.com/settings/keys/api
# ============================================================================

BREVO_API_KEY=your-brevo-api-key-here
# Get from https://app.brevo.com/settings/keys/api
# Leave empty to disable email sending (no error, just silent fail)

EMAIL_FROM_ADDRESS=olalekanquadri58@gmail.com
# Email address used in "From" field when sending emails
# Should match your Brevo sender identity

EMAIL_FROM_NAME=Global Digital Skills Assessment
# Display name used in "From" field when sending emails

# --- PAYMENT CONFIGURATION ---
PAYMENTS_ENABLED=false
# Set to true to enable payment checkouts
# Currently deactivated platform-wide (login replaced $1 unlock tier)

# --- STRIPE CONFIGURATION (if payments enabled) ---
STRIPE_SECRET_KEY=sk_test_replace_me_with_real_key
# Get from https://dashboard.stripe.com/apikeys
# Test mode key starts with: sk_test_
# Live mode key starts with: sk_live_
# NEVER use live keys in development!

STRIPE_WEBHOOK_SECRET=whsec_replace_me_with_real_secret
# Get from https://dashboard.stripe.com/webhooks
# Used to validate webhook signatures from Stripe

STRIPE_PRICE_USD_CENTS=100
# Price in cents (e.g., 100 = $1.00, 9999 = $99.99)

# --- PAYSTACK CONFIGURATION (if payments enabled) ---
PAYSTACK_SECRET_KEY=sk_test_replace_me_with_real_key
# Get from https://dashboard.paystack.com/#/settings/developer
# Test mode key starts with: sk_test_
# Live mode key starts with: sk_live_

PAYSTACK_PUBLIC_KEY=pk_test_replace_me_with_real_key
# Get from https://dashboard.paystack.com/#/settings/developer
# Test mode key starts with: pk_test_
# Live mode key starts with: pk_live_

PAYSTACK_AMOUNT_KOBO=150000
# Amount in Kobo (1 Naira = 100 Kobo)
# Example: 150000 = 1500 Naira

# --- CONSULTATION BOOKING ---
CONSULTATION_BOOKING_URL=https://calendly.com/your-handle/consultation
# Link to your Calendly or Cal.com calendar for booking consultations
# Update to your actual booking URL

# --- PORTFOLIO/COMPANY ---
PORTFOLIO_URL=https://quaddev.onrender.com/
# Your portfolio or company website URL
# Shown in footer and email templates

# ============================================================================
# RENDER DEPLOYMENT INSTRUCTIONS
# ============================================================================
# 
# 1. Connect your GitHub repository to Render
# 
# 2. Create PostgreSQL database service:
#    - Service name: "career-assessment-db"
#    - Database name: "assessment"
#    - User: "assessment_user" (auto-generated)
#    - Grab the "Internal Database URL" after creation
# 
# 3. Create backend Web Service:
#    - Name: "career-assessment-backend"
#    - Runtime: Python 3.13
#    - Build Command: pip install -r requirements.txt
#    - Start Command: uvicorn app.main:app --host 0.0.0.0 --port $PORT
#    - Root Directory: backend
#    - Environment Variables (see render.yaml):
#      * ENVIRONMENT=production
#      * DATABASE_URL=[Paste PostgreSQL Internal Database URL]
#      * SECRET_KEY=[Generate with: python -c "import secrets; print(secrets.token_hex(32))"]
#      * BREVO_API_KEY=[Your Brevo API key]
#      * ADMIN_EMAILS=olalekanquadri58@gmail.com
#      * All other variables from this file
# 
# 4. Create frontend Static Service:
#    - Name: "career-assessment-frontend"
#    - Build Command: npm install && npm run build
#    - Publish Directory: dist
#    - Root Directory: frontend
#    - Environment Variable:
#      * VITE_API_URL=https://[your-backend-service].onrender.com
# 
# 5. Update render.yaml with your actual Render service URLs
# 
# ============================================================================


